# AgentEco backend API (the Railway "api" service in production).
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Network (see lib/web3/network.ts) ---
# testnet (default) or mainnet. Chain id, RPC, and explorer come from the preset.
NEXT_PUBLIC_NETWORK=testnet
# Optional — overrides the preset's public RPC.
NEXT_PUBLIC_RPC_URL=
# The AgentEco.sol deployment. Testnet has defaults; a mainnet BUILD FAILS
# without NEXT_PUBLIC_AGENT_ECO_ADDRESS and NEXT_PUBLIC_DEPLOY_BLOCK. USDT
# defaults to the chain's USDT on both networks.
NEXT_PUBLIC_AGENT_ECO_ADDRESS=
NEXT_PUBLIC_USDT_ADDRESS=
NEXT_PUBLIC_DEPLOY_BLOCK=
# These are baked in at build time — change one, then redeploy.
