# --- Keeper (existing) ---
RPC_URL=https://rpc.bohr.life
AGENT_ECO_ADDRESS=0x0a68fe20feA2780cF1AC32862504021D96a8E50C
KEEPER_PRIVATE_KEY=
KEEPER_INTERVAL_MS=30000

# Optional. If unset and no checkpoint file exists yet, the keeper starts
# watching for EscrowCreated events from the current block onward (no
# historical backfill). Set this to the contract's deployment block to
# backfill escrows created before the keeper's first run.
DEPLOYMENT_BLOCK=

# Optional. When true, the keeper logs what it *would* call but never
# sends a transaction. Defaults to false.
DRY_RUN=false

# --- API server (Agent Registry, Discovery, Negotiation, Orders) ---
# From Supabase: Project > Connect > ORMs tab > Prisma.
# DATABASE_URL is the pooled connection (used at runtime by the API).
# DIRECT_URL is the direct connection (used only by `prisma migrate`).
DATABASE_URL=
DIRECT_URL=

# Port the Express API listens on.
API_PORT=4000

# Origin allowed to call the API (the Next.js frontend dev server).
FRONTEND_ORIGIN=http://localhost:3000

# --- Hosted buyer agents ("make an agent buy for me") ---
# AES-256-GCM key for encrypting hosted buyer agents' own private keys at
# rest — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Testnet-demo custodial trade-off only — see src/agentKeyCrypto.ts.
AGENT_KEY_ENCRYPTION_SECRET=

# Host runtime (src/hostMain.ts) — separate long-running process, polls for
# active hosted buyer tasks and negotiates/funds/settles for them.
HOST_INTERVAL_MS=5000

# Where the host reaches the API. Leave unset locally (defaults to
# http://localhost:$API_PORT); set it when the API is a separate deployed
# service, e.g. https://agenteco-api.up.railway.app
AGENTECO_API_URL=
