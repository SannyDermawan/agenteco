# AgentEco backend API this agent registers itself against.
AGENTECO_API_URL=http://localhost:4000

# This agent's own wallet. Generate one with:
#   node -e "import('viem/accounts').then(({generatePrivateKey})=>console.log(generatePrivateKey()))"
WALLET_PRIVATE_KEY=

# Optional. If unset and no checkpoint file (.seller-agent-state.json)
# exists yet, this agent starts watching for escrows naming it as seller
# from the current block onward (no historical backfill). Set this to the
# contract's deployment block to backfill escrows funded before this
# agent's first run.
DEPLOYMENT_BLOCK=
